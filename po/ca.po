#. Translators: title of the row that opens the acknowledgements page
#. (like credits but separate, e.g. for patreon backers)
#: src/adw-about-dialog.ui:228 src/adw-about-window.ui:231
msgid "_Acknowledgements"
msgstr "_Reconeixements"

#. Translators: title of the release notes page
#: src/adw-about-dialog.ui:264 src/adw-about-window.ui:262
msgid "What’s New"
msgstr "Novetats"

#. Translators: title of the details page (comment, website etc)
#: src/adw-about-dialog.ui:311 src/adw-about-window.ui:309
msgid "Details"
msgstr "Detalls"

#. Translators: title of the troubleshooting page
#: src/adw-about-dialog.ui:371 src/adw-about-window.ui:369
msgid "Troubleshooting"
msgstr "Solució de problemes"

#. Translators: comment at the top of the troubleshooting page
#: src/adw-about-dialog.ui:395 src/adw-about-window.ui:393
msgid ""
"To assist in troubleshooting, you can view your debugging information. "
"Providing this information to the application developers can help diagnose "
"any problems you encounter when you report an issue."
msgstr ""
"Per a ajudar en la resolució de problemes, podeu veure la informació de "
"depuració. Proporcionar aquesta informació als desenvolupadors de "
"l'aplicació pot ajudar a diagnosticar qualsevol problema que trobeu quan "
"informeu d'un problema."

#. Translators: title of the row that opens the debug information page
#: src/adw-about-dialog.ui:407 src/adw-about-window.ui:405
msgid "_Debugging Information"
msgstr "_Informació de depuració"

#. Translators: title of the debug information page
#: src/adw-about-dialog.ui:435 src/adw-about-window.ui:433
msgid "Debugging Information"
msgstr "Informació de depuració"

#. Translators: label of a button on the debug information page
#: src/adw-about-dialog.ui:484 src/adw-about-window.ui:482
msgid "_Copy Text"
msgstr "_Copia el text"

#. Translators: label of a button on the debug information page
#: src/adw-about-dialog.ui:493 src/adw-about-window.ui:491
msgid "_Save As…"
msgstr "De_sa com a…"

#. Translators: title of the credits page
#: src/adw-about-dialog.ui:507 src/adw-about-window.ui:505
msgid "Credits"
