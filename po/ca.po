#: src/adw-about-dialog.ui:136 src/adw-about-dialog.ui:350
#: src/adw-about-window.ui:139 src/adw-about-window.ui:348
msgid "_Website"
msgstr "_Lloc web"

#. Translators: title of the row that opens the app's support forum
#: src/adw-about-dialog.ui:152 src/adw-about-window.ui:155
msgid "_Support Questions"
msgstr "_Preguntes de suport"

#. Translators: title of the row that opens the app's issue tracker
#: src/adw-about-dialog.ui:162 src/adw-about-window.ui:165
