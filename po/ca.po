#. Translators: designers section title in credits
#: src/adw-about-dialog.c:613 src/adw-about-window.c:603
msgid "Design by"
msgstr "Dissenyat per"

#. Translators: artists section title in credits
#: src/adw-about-dialog.c:615 src/adw-about-window.c:605
msgid "Artwork by"
msgstr "Treball artístic per"

#. Translators: documenters section title in credits
#: src/adw-about-dialog.c:617 src/adw-about-window.c:607
msgid "Documentation by"
