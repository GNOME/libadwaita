#: src/adw-about-dialog.ui:6 src/adw-about-window.ui:6
msgid "About"
msgstr "Относно"

#. Translators: title of the row that opens the release notes page
#: src/adw-about-dialog.ui:102 src/adw-about-window.ui:105
msgid "What’s _New"
msgstr "Какво _ново"

#. Translators: title of the row that opens the details page (comment, website etc)
#: src/adw-about-dialog.ui:119 src/adw-about-window.ui:122
msgid "_Details"
msgstr "_Подробности"

#. Translators: title of the row that opens the app's website
#: src/adw-about-dialog.ui:136 src/adw-about-dialog.ui:350
#: src/adw-about-window.ui:139 src/adw-about-window.ui:348
msgid "_Website"
msgstr "_Уеб сайт"

#. Translators: title of the row that opens the app's support forum
#: src/adw-about-dialog.ui:152 src/adw-about-window.ui:155
msgid "_Support Questions"
msgstr "_Въпроси по поддръжката"

#. Translators: title of the row that opens the app's issue tracker
#: src/adw-about-dialog.ui:162 src/adw-about-window.ui:165
msgid "_Report an Issue"
msgstr "_Докладване на грешка"

#. Translators: title of the row that opens the troubleshooting page
#: src/adw-about-dialog.ui:172 src/adw-about-window.ui:175
msgid "_Troubleshooting"
msgstr "_Справяне с проблеми"

#. Translators: title of the row that opens the credits page
#: src/adw-about-dialog.ui:193 src/adw-about-window.ui:196
msgid "_Credits"
msgstr "_Сътрудници"

#. Translators: title of the row that opens the legal page (copyright, license)
#: src/adw-about-dialog.ui:210 src/adw-about-window.ui:213
msgid "_Legal"
